{
  "paths": {
    "raw_data": "data/raw",
    "cropped_labeled": "data/sementes_recortadas_anotadas",
    "cropped_unlabeled": "data/sementes_recortadas",
    "output": "output",
    "checkpoints": "checkpoints"
  },

  "common": {
    "seed": 42
  },

  "segmentation": {
    "file_templates": {
      "rgb": "RIP2_{id}-RGB.tif",
      "rx":  "RIP2_{id}.tif",
      "bil": "RIP2_{id}.bil",
      "hdr": "RIP2_{id}.bil.hdr",
      "json": "RIP2_{id}-RGB.json"
    },
    "discovery": { "enabled": true, "require": ["rgb","rx","bil","hdr"] },
    "labeled_ids": [],
    "unlabeled_ids": [],
    "pipeline": {
      "roi_rgb": [30, 600, 200, 650],
      "roi_rx": [109, 2331, 0, 2368],
      "crop_size": [64, 45],
      "columns_per_row": 5,
      "expected_seeds": 50,
      "n_hyperspectral_bands": 150,
      "rgb_erosion": 13, "rgb_dilation": 3,
      "rx_erosion": 5, "rx_dilation": 2,
      "min_circularity": 0.3, "min_area": 0.3,
      "disk_open": 2, "disk_close": 1
    }
  },

  "classification": {
    "models": ["vgg16","vgg19","resnet50","inception_v3","efficientnet_b0","mobilenet_v3_large"],
    "features_dir": "output/features",
    "torch_training": {
      "epoch_num": 10, "lr": 0.001, "weight_decay": 0.008, "batch_size": 20
    },
    "cv_folds": 5
  },

  "xai": {
    "experiment_name": "exp1",
    "training": {
      "epochs": 15, "batch_size": 20, "lr": 0.001, "weight_decay": 0.008,
      "cv_folds": 5, "early_stopping_patience": 4,
      "unfreeze_after_epoch": 5, "unfreeze_lr_scale": 0.01
    },
    "checkpoints": {
      "vgg19": "checkpoints/exp1/vgg19/vgg19_fold_{fold}.pth",
      "resnet50": "checkpoints/exp1/resnet50/resnet50_fold_{fold}.pth"
    },
    "test_samples": []
  }
}